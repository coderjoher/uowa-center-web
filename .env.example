# Content admin at /admin. Set these on the host (Wasmer app → Settings →
# Environment variables); never commit real values.

# What editors type in at /admin.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token with "Contents: Read and write" on this repository
# only. The admin commits content changes with it; the browser never sees it.
GITHUB_TOKEN=
