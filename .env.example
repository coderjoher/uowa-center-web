# --- Content admin (see README "Content: the admin at /admin") -------------
# Leave DATABASE_URL unset to render the bundled copy in public/content;
# /admin then explains that it isn't configured.

# Postgres connection string. The tables are created, and filled with the
# bundled content, on first start.
DATABASE_URL=

# Where uploaded pictures and videos are stored (default: .media/ here).
MEDIA_DIR=

# Lets POST /api/revalidate (header x-revalidate-secret) re-render every page.
# The Docker image calls it on start.
REVALIDATE_SECRET=
