# --- Content from the Strapi CMS (see cms/README.md) -----------------------
# Leave STRAPI_URL unset to build from the bundled copy in public/content.

# Where the site fetches content from (server to server).
STRAPI_URL=

# Public origin of the CMS, for images and videos uploaded there, and for the
# /admin redirect. Only needed if it differs from STRAPI_URL.
STRAPI_PUBLIC_URL=

# Shared secret Strapi's webhook sends in the `x-revalidate-secret` header
# to POST /api/revalidate, so published edits show immediately.
REVALIDATE_SECRET=
